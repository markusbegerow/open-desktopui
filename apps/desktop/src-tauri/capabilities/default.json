{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the chat windows and the quick chat",
  "windows": ["main", "chat-*", "quick"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "dialog:default",
    "autostart:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    "log:default",
    "updater:default",
    "process:default",
    "deep-link:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
