{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "chat-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "dialog:default",
    "autostart:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    "log:default",
    "updater:default",
    "process:default"
  ]
}
